APP_MODE=demo
DATABASE_URL=postgres://relay:relay@127.0.0.1:55432/relay
# Tests require a separate database whose name ends in _test.
# TEST_DATABASE_URL=postgres://relay:relay@127.0.0.1:55432/relay_test
APP_ORIGIN=http://127.0.0.1:3000
# Demo-only secret. Generate a new random value of at least 32 chars for live mode.
SESSION_SECRET=local-demo-only-change-before-live-use-0123456789
# Live mode only; keep real values in .env, never source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=high
# Includes reasoning tokens and the structured ticket facts.
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Intake pipeline: deterministic, single, or multi.
RELAY_PIPELINE=deterministic
JIRA_EMAIL=
JIRA_API_TOKEN=
# Cloud-only mapping: JSON contents of config/jira.json (no API token inside).
# Leave blank locally to use config/jira.json instead.
JIRA_CONFIG_JSON=
# Sandbox smoke testing is disabled unless explicitly set to 1.
ALLOW_LIVE_SMOKE=0
# Optional deterministic failure injection; use only in demo mode.
DEMO_LOST_CREATE_RESPONSE=0
DEMO_FAIL_UPDATE=0
