APP_MODE=demo
DATABASE_URL=postgres://relay:relay@127.0.0.1:55432/relay
# Tests require a separate database whose name ends in _test.
# TEST_DATABASE_URL=postgres://relay:relay@127.0.0.1:55432/relay_test
APP_ORIGIN=http://127.0.0.1:3000
# Demo-only secret. Generate a new random value of at least 32 chars for live mode.
SESSION_SECRET=local-demo-only-change-before-live-use-0123456789
# Live mode only; keep real values in .env, never source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=high
# Includes reasoning tokens and the structured ticket facts.
# Both model settings are validated in demo mode too, so an invalid value fails intake there.
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Intake pipeline: deterministic (rules plus extraction), single (one agent), or multi
# (triage agent plus an independent reviewer). Defaults to single, the shipped arm.
# In live mode the multi arm runs asynchronously on the worker; the API answers with state "processing".
RELAY_PIPELINE=single
# RELAY_INTAKE_INLINE=1 forces the multi arm to run inside the request (local debugging only).
# Detail level for a screenshot sent with a chat message: auto, low or high.
# RELAY_IMAGE_DETAIL=auto
# Token prices in USD per million, overriding config/pricing.json for OPENAI_MODEL only.
# Each one is optional and replaces only that rate; an unpriced model records no cost, not a zero.
# OPENAI_PRICE_INPUT_PER_M=
# OPENAI_PRICE_CACHED_INPUT_PER_M=
# OPENAI_PRICE_OUTPUT_PER_M=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Cloud-only mapping: JSON contents of config/jira.json (no API token inside).
# Leave blank locally to use config/jira.json instead.
JIRA_CONFIG_JSON=
# Sandbox smoke testing is disabled unless explicitly set to 1.
ALLOW_LIVE_SMOKE=0
# Optional deterministic failure injection; use only in demo mode.
DEMO_LOST_CREATE_RESPONSE=0
DEMO_FAIL_UPDATE=0
