APP_MODE=demo
DATABASE_URL=postgres://relay:relay@127.0.0.1:55432/relay
APP_ORIGIN=http://127.0.0.1:3000
# Demo-only secret. Generate a new random value of at least 32 chars for live mode.
SESSION_SECRET=local-demo-only-change-before-live-use-0123456789
# Live mode only; keep real values in .env, never source control.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Sandbox smoke testing is disabled unless explicitly set to 1.
ALLOW_LIVE_SMOKE=0
# Optional deterministic failure injection; use only in demo mode.
DEMO_LOST_CREATE_RESPONSE=0
DEMO_FAIL_UPDATE=0
