{
  "name": "relay-it-support",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && uv run python -m relay.local",
    "build": "next build",
    "start": "uv run python -m relay.web",
    "lint": "oxlint",
    "format": "oxfmt",
    "worker": "uv run python -m relay.worker",
    "setup": "uv run python -m relay.cli setup",
    "test": "uv run python -m pytest",
    "eval": "uv run python -m relay.cli eval",
    "typecheck": "tsc --noEmit",
    "test:web": "node --import tsx --test lib/*.test.ts",
    "demo": "npm run build && uv run python -m relay.local demo",
    "live": "npm run build && uv run python -m relay.local live",
    "preflight": "uv run python -m relay.cli preflight",
    "session": "uv run python -m relay.cli session",
    "user:provision": "uv run python -m relay.cli provision-user",
    "sources:copy-sandbox": "uv run python -m relay.cli copy-sandbox-sources",
    "embed:sources": "uv run python -m relay.cli embed-sources",
    "smoke:live": "uv run python -m relay.cli smoke-live",
    "retention": "uv run python -m relay.cli retention",
    "smoke:http": "uv run python -m pytest tests_python/test_api.py"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "railway": "3.11.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "type": "module"
}
